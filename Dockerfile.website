# ---------- Stage: Hotel Booking Website ----------
# Serves the Vite React app on port 5173, accessible
# across the Docker network so the automation container
# can reach it at http://website:5173.

FROM node:22-alpine

WORKDIR /app

# Install deps first (layer cache)
COPY Hotel_Booking/package.json Hotel_Booking/package-lock.json ./
RUN npm ci

# Copy source
COPY Hotel_Booking/ ./

# Vite dev server must bind to 0.0.0.0 to be reachable
# from other containers on the Docker network.
EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
